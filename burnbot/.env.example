# ── Robin Labs Buyback & Burn Bot. Copy to `.env` and fill in. NEVER commit .env ──

# Broadcast-capable Robinhood Chain RPC (accepts eth_sendRawTransaction). SECRET
# if it has a key in the URL.
RPC_URL=

# The burn wallet's PRIVATE KEY. SECRET — .env only, never commit.
# Generate a fresh one:  node -e "const{ethers}=require('ethers');const w=ethers.Wallet.createRandom();console.log('address',w.address);console.log('key    ',w.privateKey)"
# Then FUND the printed address with Robinhood ETH — that's the money the bot burns with.
BURN_PRIVATE_KEY=

# Token to buy & burn. Defaults to $ROBIN.
TOKEN=0x6696FE29288B586017E6f264c0091DBA6C5ebeaf

# ETH to spend per dip-buy: a number (e.g. 0.05) or "max". Small + hourly is the
# default — 0.05/hour means ~2.4 ETH lasts ~48h of dip-buys.
BUYBACK_ETH=0.05

# Always keep this much ETH for gas; never spend into it.
GAS_RESERVE_ETH=0.003

# Don't buy while the balance is below this (avoid dust cycles).
MIN_BALANCE_ETH=0.01

# Slippage tolerance for the buyback (percent).
SLIPPAGE_PCT=15

# Scheduled-mode cadence in minutes (ignored by --once). Default hourly.
INTERVAL_MIN=60

# Buy ONLY on dips: buy when the price is at least DIP_PCT below the rolling
# average over the last DIP_WINDOW_HRS. Set DIP_PCT=0 to buy every cycle.
DIP_PCT=4
DIP_WINDOW_HRS=48
PROBE_ETH=0.01

# Optional: announce each burn to a Telegram chat/channel the bot admins.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Burn announcements show a row of this emoji, scaled to the burn size (bigger
# burn → more emojis, one per EMOJI_STEP_ETH, capped at EMOJI_MAX).
BURN_EMOJI=🦊
# For a CUSTOM animated emoji, put its numeric id here (get it with:
#   node getEmojiId.js   after DMing the emoji to the bot). Blank = plain emoji.
CUSTOM_EMOJI_ID=
EMOJI_STEP_ETH=0.01
EMOJI_MAX=50

# Where the burn ledger persists (mount a volume in prod).
DATA_DIR=./data

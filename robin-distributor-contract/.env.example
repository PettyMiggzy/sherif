# Copy to `.env` and fill in. NEVER commit .env.

# Owner / funder wallet (deploys, loads recipients, triggers distribution).
PRIVATE_KEY=

# Robinhood Chain (chainId 4663).
ROBINHOOD_RPC=https://robinhoodchain.blockscout.com/api/eth-rpc

# ── Recommended path: stateless one-tx multisend + auto-watcher ──────────────
# Set after `npm run deploy:disperse` prints it.
DISPERSE_ADDRESS=

# watcher tuning
POLL_MS=12000            # how often to check the wallet for new deposits
MIN_DEPOSIT_WEI=0        # ignore deposits smaller than this (wei)
SAFE_GAS=14000000        # per-tx gas ceiling for batching (< the 16,777,216 cap)
GAS_BUFFER=1.05          # gasPrice = baseFee × this (this chain's baseFee is flat ~0.052 gwei)
# GAS_PRICE_WEI=         # hard-pin the gasPrice instead (skips baseFee logic)

# ── AUTOPILOT (npm run autopilot): deposit → auto-fund wallets → auto-buy ─────
# The buy amount per trade, in wei. 1e-7 ETH = the floor (gas is ~98% of a buy's
# cost on this chain, so lower barely helps). Raise for bigger buys / fewer of them.
BUY_AMOUNT_IN_WEI=100000000000
# Gas ceiling per buy. Observed buys use ~129k; 135k leaves a ~5% margin. Raising
# it is safer against out-of-gas but forces funding each wallet more (more dust);
# lowering toward ~132k squeezes a few % more buys out but is riskier.
BUY_GAS_LIMIT=135000
FUND_BUFFER_BP=300       # fund each wallet 3% over one buy's need (headroom)
BUY_CONCURRENCY=8        # how many wallets buy in parallel each round
# Pool size for `npm run generate`. FEWER wallets = MORE total transactions, because
# each wallet is reused ("warm") instead of paying the ~$0.0033 new-wallet gas tax
# every time. 200 is the sweet spot: ~99% of the max tx count, 200 distinct buyers,
# good parallelism. Raise it only if you want more distinct addresses (costs ~15% of
# your tx count). Lower than ~50 gains nothing and kills parallelism.
WALLET_COUNT=200

# ── Alternative path: the stateful RobinDistributor contract ─────────────────
# Set after `npm run deploy` prints it.
CONTRACT_ADDRESS=

# The increment. Default $0.0000814 of ETH, priced live (CoinGecko).
INCREMENT_USD=0.0000814
# Pin the price for offline/deterministic unit sizing, e.g. ETH_USD=3500
ETH_USD=
# Or pin the increment directly (skips pricing): INCREMENT_WEI=23257142857

# Distribution mode:
#   fixed = exactly one $0.0000814 step per wallet (what you want) — default
#   even  = split the whole contract balance evenly across all wallets
DISTRIBUTE_MODE=fixed

# Batch sizes (kept well under the 2^24 per-tx gas cap).
LOAD_BATCH=200
DISTRIBUTE_BATCH=200

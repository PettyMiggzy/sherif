# Copy to .env.local (or set these in Vercel) only to override the defaults.
# Every value below is already the built-in default in lib/config.ts, so the
# site builds and runs against Elysium testnet with no env at all.

# Kinetiq's Elysium RPC: CORS-open and write-capable (wallets are handed it
# when they add the network). It ships in the site bundle, so it's public.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_CHAIN_ID=99801
NEXT_PUBLIC_CHAIN_NAME=Elysium Testnet
NEXT_PUBLIC_EXPLORER_URL=https://test-explorer.elysium.kinetiq.xyz

# Elysium Pad (usdg-pad/script/DeployElysium.s.sol).
NEXT_PUBLIC_PORTAL=0x788A959628C49b7eB92e6FCe9154dF775B4d709c
NEXT_PUBLIC_HOOK=0x4eB7CD0299021045A92B67a8EE48DE8aA4CA68Cc
NEXT_PUBLIC_TREASURY=0x256772d87147C91749646F8365A2D760336F9E92
NEXT_PUBLIC_FEE_DESK=0xBfBBa2Db88caf8ae43Db5f066F340229967965e9
NEXT_PUBLIC_FACTORY=0xc7891BB84805D2919573499e0D11149C8972F06D
NEXT_PUBLIC_PORTAL_GENESIS_BLOCK=26320181
NEXT_PUBLIC_PAD_ADMIN=0x5899a0576A94327a6316E01190f951edf7645914

# Uniswap v4 core (the pad's own PoolManager) and the pad's swap router.
NEXT_PUBLIC_POOL_MANAGER=0xD1a514C574E60aAfCBf9fd822eF64fe963D3B4FA
NEXT_PUBLIC_ROUTER=0x4ff52c870735200162A971396a6E599536E67254
NEXT_PUBLIC_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
# Every pool's quote asset: USDC bridged from HyperEVM (6 decimals). Gas is HYPE.
NEXT_PUBLIC_USDC=0x7D29d8047B905000459c0E80c34a26CeedcB47b2
NEXT_PUBLIC_QUOTE_IS_NATIVE=false
NEXT_PUBLIC_QUOTE_DECIMALS=6

NEXT_PUBLIC_BRAND=Elysium Pad
NEXT_PUBLIC_TAGLINE=Pick your market cap. Launch in one transaction.
NEXT_PUBLIC_HOME_URL=
# Market cap the progress bars on launch cards fill toward.
NEXT_PUBLIC_MILESTONE_USD=30000
# This site's public URL, so social previews get absolute image links.
NEXT_PUBLIC_SITE_URL=https://elysiumpad.world

# Backup RPC for when the public one fails. Server-only; on testnet it
# defaults to HypeDexer's (https://elysium-testnet-rpc.hypedexer.com), on any
# other chain there is none unless set. Browsers reach it through this site's
# /api/rpc relay; NEXT_PUBLIC_RPC_FALLBACK=0 turns that off.
RPC_FALLBACK_URL=
NEXT_PUBLIC_RPC_FALLBACK=

# Where new launch tokens get their source verified: Conduit's hosted
# Sourcify, which the Elysium explorer reads. SOURCIFY_VERIFY=0 turns it off.
SOURCIFY_URL=https://contracts.conduit.xyz
SOURCIFY_VERIFY=

# Optional: a pad-indexer for 24h volume, trades, holders and candles.
NEXT_PUBLIC_INDEXER_URL=
# WalletConnect (phone wallets).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=89d7a1882c0fa9a5bbe0a58accafc100
# Server-only: a private Vercel Blob store for token pictures/descriptions and
# the launch-list snapshot. Without it the site still works; details can't be saved.
BLOB_READ_WRITE_TOKEN=

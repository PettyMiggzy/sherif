{
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/templates/coin-site/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|templates/|site\\.html|favicon|robots\\.txt|sitemap\\.xml|site\\.webmanifest|sw\\.js).*)",
      "has": [
        { "type": "host", "value": "(?<slug>[a-z0-9-]+)\\.robinlabs\\.fun" }
      ],
      "destination": "/site.html"
    }
  ]
}

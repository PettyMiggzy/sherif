# ── Robin Labs Launch Bot — config. Copy to `.env` and fill in. NEVER commit .env ──

# Telegram bot token from @BotFather. SECRET.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# RPC that can BROADCAST txs (must accept eth_sendRawTransaction). This is the
# paid/premium Robinhood Chain RPC — NOT the read-only indexer /rpc proxy. A key
# in the URL is a SECRET; keep it here, never commit.
RPC_URL=https://your-premium-robinhood-rpc

# Optional FREE/public RPC endpoint(s) for chain 4663, comma-separated. High-
# frequency READS (balances) prefer these to save RPC_URL's quota; ALL writes
# still go through RPC_URL. Blank = everything uses RPC_URL (no change). Only add
# nodes you trust — a lying read node can mis-report a balance but can never move
# funds. (Verify an endpoint answers eth_chainId = 0x1237 before adding it.)
FREE_RPCS=

# Optional BACKUP read RPC(s) for chain 4663, comma-separated (e.g. a QuikNode/paid endpoint). A key in
# the URL is a SECRET; keep it here, never commit. Unlike FREE_RPCS these are NOT preferred — they sit at
# the same backstop tier as RPC_URL and are used only when a primary/free read stalls or fails. ALL writes
# still go through RPC_URL. Blank = none.
BACKUP_RPCS=

# 32+ byte secret that encrypts every custodial private key at rest. SECRET.
# If it leaks, every wallet is exposed. If it's lost, every wallet is
# unrecoverable. Generate once:  openssl rand -hex 32
MASTER_SECRET=

# Indexer + site (public). Used for pfp upload and chart links.
API_BASE=https://api.robinlab.io
SITE_BASE=https://robinlab.io

# Public Terms/Privacy URL, shown in /start + /disclaimer. Register the same
# privacy policy in @BotFather. Strongly recommended (Telegram §4/§9.1).
TERMS_URL=

# Anti-spam: min seconds between one user's launches (Telegram §5.2b).
LAUNCH_COOLDOWN_SECS=60

# Extra banned words for coin name/ticker moderation, comma-separated (optional;
# a base slur/impersonation denylist is always on).
BLOCKED_WORDS=

# Optional: announce every new launch into this group/channel (free promo).
# The bot must be a member/admin of it. Blank = off. (Posting to your own
# channel is fine under Telegram ToS; the bot never DMs users unsolicited.)
ANNOUNCE_CHAT_ID=

# Optional: your Telegram user id (for admin/logging). Not required.
ADMIN_ID=

# Slippage tolerance for /buy and /sell (percent).
SLIPPAGE_PCT=12

# Optional on-chain bot fee per launch (in ETH), sent to FEE_WALLET. 0 = off.
# This is charged ON-CHAIN in ETH — never via Telegram Stars (ToS-compliant).
LAUNCH_FEE_ETH=0
FEE_WALLET=

# Where /paysupport points users.
SUPPORT_URL=t.me/robinlabs

# Where the encrypted wallet store lives (mount a persistent volume here in prod).
# The moderation state (moderation.json) is written here too.
DATA_DIR=./data

# ── Group moderation (optional tuning; sane defaults if unset) ──────────────────
# The bot moderates any group where it is an ADMIN (Ban Users + Delete Messages).
# Per-group toggles (captcha/antilink/antiflood/warnlimit/mutetime) are set live
# with /set inside each group; these envs only change the global thresholds.
FLOOD_MSGS=6         # messages within FLOOD_SECS from one user → auto-mute
FLOOD_SECS=7
CAPTCHA_SECS=120     # seconds a new member has to tap "I'm human" before removal
JOIN_BURST=8         # joins within JOIN_WINDOW → auto-lockdown + admin alert
JOIN_WINDOW=20

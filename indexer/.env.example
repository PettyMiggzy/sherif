# ── Robin Labs Pad indexer config ──────────────────────────────────────────
# Copy to .env and fill in. Nothing here is secret unless you use a private RPC.

# RPC endpoint. The public Blockscout eth-rpc works out of the box; swap in a
# private archive RPC (Alchemy/your own node) for faster, higher-limit backfills.
RPC_URL=https://robinhoodchain.blockscout.com/api/eth-rpc

# Optional BACKUP RPC (e.g. QuikNode/paid). A key in the URL is a SECRET — keep it here, never commit.
# Used ONLY as a priority-2 backstop: the core poller fails over to it if RPC_URL stalls/errors (so a
# primary outage doesn't stall indexing), and the /rpc proxy tries it before the blockscout fallback.
# Reads only; the reward poster always broadcasts on RPC_URL. Blank = single primary provider (no change).
# RPC_BACKUP=

# Deployed Robin Labs contracts (LIVE on Robinhood Chain).
FACTORY=0x7E9E3BC24013e6f607e89c52E619B6FD77334DC2
ROUTER=0x7d0c7122E26a75A9f0bd753e84c6115CAfE3Fd9F

# Block to start indexing from. Set this to the factory's deploy block so the
# first backfill doesn't crawl the whole chain. Find it on the explorer:
#   robinhoodchain.blockscout.com/address/<FACTORY> → first tx block.
# 0 = scan from genesis (slower first run, still correct).
START_BLOCK=15944153

# Tuning.
PORT=8787              # API port
POLL_MS=6000           # how often to poll for new blocks. eth_getLogs is ~90% of RPC
                       # compute and scales with poll frequency — raise this (e.g. 20000
                       # = 20s) to cut a paid RPC's cost ~proportionally. A memecoin feed
                       # is fine a few seconds behind.
CHUNK=1500             # blocks per getLogs call (lower it if the RPC rejects the range)
# LOGS_RPC=            # OPTIONAL second endpoint for getLogs only (a self-hosted node or a
                       # PAID Blockscout/alt plan). Blank = all getLogs on RPC_URL. Do NOT set
                       # this to the public Blockscout endpoint — it rate-limits the per-pool
                       # getLogs burst. Reduce cost via POLL_MS instead.
CONFIRMATIONS=3        # treat head-N as final; re-scan the tip each poll for reorgs
DB_PATH=./data/robinlabs.db

# CORS origin allow-list for the API (comma-separated). * = allow any (fine for a
# read-only public API). Lock it to your domain in production if you prefer.
# NOTE: with the docker-compose + Caddy setup the site and API share one origin,
# so CORS never comes into play — leave it as * or set it to your domain.
CORS_ORIGIN=*

# ── rewards (RewardVault merkle poster) ─────────────────────────────────────
# Leave REWARD_VAULT blank to disable the whole reward pipeline (no Accrued
# indexing, no posting). Set it to the deployed RewardVault to turn it on.
# LIVE on Robinhood Chain: 0x03d5d26E492B288e62D897E7dde91af3CceB4347
REWARD_VAULT=
# MUST match the contract exactly, or roots cover the wrong epoch / finality window:
EPOCH_LEN=604800        # = RewardVault.EPOCH (deploy default: 7 days)
FINALITY_DELAY=86400    # = RewardVault.finalityDelay (deploy default: 24h). MUST equal the deployed value.
# The POSTER account's private key — signs postRoot() on-chain. SECRET: put it in
# .env (gitignored), never commit it. Omit to run compute-only (leaves + proofs
# are computed and served, but no root is posted on-chain — useful for a dry run).
POSTER_KEY=
# Optional prefix for the on-chain leaf-set `uri` (e.g. an IPFS gateway you pin to).
# Blank = a self-descriptive "robinlabs:rewards:epoch:<n>" tag; the real set is
# always served at /api/rewards/epoch/<n> regardless.
REWARD_URI_BASE=
# Min TIME-AVERAGED holding a wallet needs to accrue HOLDER rewards, in bps of the
# 1e9 supply (2 = 0.02% = 200,000 tokens). Sub-threshold holders roll into the
# coin's floor. 0 disables the gate.
HOLDER_MIN_BPS=2
# The dev vesting-lock singleton (scripts/deploy-vesting.js) — excluded from rewards
# and indexed for the dev-lock badge. "" until deployed.
# LIVE on Robinhood Chain: 0x7453856c3E5f6832dc660e48c7Daa6f46f3355DF
TOKEN_VESTING_LOCK=

# ── coin profiles (creator-signed image / banner / socials) ─────────────────
# Cosmetic, off-chain metadata a coin's creator can set via POST /api/coin/:token/meta
# (verified against the coin's on-chain dev). Images are size-capped blobs served from
# GET /media/:token/:kind. Nothing here touches trading; leave the defaults for most setups.
PROFILE_MAX_IMAGE_BYTES=819200   # 800 KB per image (pfp/banner), after base64 decode
PROFILE_MAX_SIG_AGE=600          # reject a profile signature older/newer than this (seconds)

# ── docker-compose only ─────────────────────────────────────────────────────
# Your domain. Caddy gets an automatic HTTPS cert for it and serves BOTH the
# static pad and the API here. Leave blank / ":80" for local plain-HTTP testing.
# Then set API_BASE in pad/assets/config.js to "https://<this domain>".
SITE_DOMAIN=

# For a launch that could see 10k people at once, DON'T use the public RPC —
# point RPC_URL above at your Alchemy or QuickNode Robinhood Chain endpoint.
# The indexer is the only thing that talks to the RPC; users' wallets use their
# own. A private RPC also lets you raise CHUNK for much faster backfills.

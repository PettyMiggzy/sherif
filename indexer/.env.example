# ── Robin Labs Pad indexer config ──────────────────────────────────────────
# Copy to .env and fill in. Nothing here is secret unless you use a private RPC.

# RPC endpoint. Use the chain's own public RPC below; swap in a
# private archive RPC (Alchemy/your own node) for faster, higher-limit backfills.
# The chain's own public RPC. Blockscout's eth-rpc rate-limits per IP hard enough to 429 a
# single manual query, let alone an indexer — do not use it as the primary.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional BACKUP RPC (e.g. QuikNode/paid). A key in the URL is a SECRET — keep it here, never commit.
# Used ONLY as a priority-2 backstop: the core poller fails over to it if RPC_URL stalls/errors (so a
# primary outage doesn't stall indexing), and the /rpc proxy tries it before the blockscout fallback.
# Reads only; the reward poster always broadcasts on RPC_URL. Blank = single primary provider (no change).
# RPC_BACKUP=

# Deployed Robin Labs contracts (LIVE on Robinhood Chain).
FACTORY=0x8aa92d5297fEC45cbC7F16A32F4aed5D3AC58074
ROUTER=0xA6BaAB820809C7fC8350311776627298f91F07eC

# Block to start indexing from. Set this to the factory's deploy block so the
# first backfill doesn't crawl the whole chain. Find it on the explorer:
#   robinhoodchain.blockscout.com/address/<FACTORY> → first tx block.
# 0 = scan from genesis (slower first run, still correct).
START_BLOCK=17752965

# Tuning.
PORT=8787              # API port
POLL_MS=6000           # how often to poll for new blocks. eth_getLogs is ~90% of RPC
                       # compute and scales with poll frequency — raise this (e.g. 20000
                       # = 20s) to cut a paid RPC's cost ~proportionally. A memecoin feed
                       # is fine a few seconds behind.
CHUNK=1500             # blocks per getLogs call (lower it if the RPC rejects the range)
# LOGS_RPC=            # OPTIONAL second endpoint for getLogs only (a self-hosted node or a
                       # PAID Blockscout/alt plan). Blank = all getLogs on RPC_URL. Do NOT set
                       # this to the public Blockscout endpoint — it rate-limits the per-pool
                       # getLogs burst. Reduce cost via POLL_MS instead.
CONFIRMATIONS=3        # treat head-N as final; re-scan the tip each poll for reorgs
DB_PATH=./data/robinlabs.db

# CORS origin allow-list for the API (comma-separated). * = allow any (fine for a
# read-only public API). Lock it to your domain in production if you prefer.
# NOTE: with the docker-compose + Caddy setup the site and API share one origin,
# so CORS never comes into play — leave it as * or set it to your domain.
CORS_ORIGIN=*

# ── rewards (RewardVault merkle poster) ─────────────────────────────────────
# Leave REWARD_VAULT blank to disable the whole reward pipeline (no Accrued
# indexing, no posting). Set it to the deployed RewardVault to turn it on.
# LIVE on Robinhood Chain: 0x03d5d26E492B288e62D897E7dde91af3CceB4347
REWARD_VAULT=
# MUST match the contract exactly, or roots cover the wrong epoch / finality window:
EPOCH_LEN=604800        # = RewardVault.EPOCH (deploy default: 7 days)
FINALITY_DELAY=86400    # = RewardVault.finalityDelay (deploy default: 24h). MUST equal the deployed value.
# The POSTER account's private key — signs postRoot() on-chain. SECRET: put it in
# .env (gitignored), never commit it. Omit to run compute-only (leaves + proofs
# are computed and served, but no root is posted on-chain — useful for a dry run).
POSTER_KEY=
# Optional prefix for the on-chain leaf-set `uri` (e.g. an IPFS gateway you pin to).
# Blank = a self-descriptive "robinlabs:rewards:epoch:<n>" tag; the real set is
# always served at /api/rewards/epoch/<n> regardless.
REWARD_URI_BASE=
# Min TIME-AVERAGED holding a wallet needs to accrue HOLDER rewards, in bps of the
# 1e9 supply (2 = 0.02% = 200,000 tokens). Sub-threshold holders roll into the
# coin's floor. 0 disables the gate.
HOLDER_MIN_BPS=2
# The dev vesting-lock singleton (scripts/deploy-vesting.js) — excluded from rewards
# and indexed for the dev-lock badge. "" until deployed.
# LIVE on Robinhood Chain: 0x7453856c3E5f6832dc660e48c7Daa6f46f3355DF
TOKEN_VESTING_LOCK=

# ── coin profiles (creator-signed image / banner / socials) ─────────────────
# Cosmetic, off-chain metadata a coin's creator can set via POST /api/coin/:token/meta
# (verified against the coin's on-chain dev). Images are size-capped blobs served from
# GET /media/:token/:kind. Nothing here touches trading; leave the defaults for most setups.
PROFILE_MAX_IMAGE_BYTES=819200   # 800 KB per image (pfp/banner), after base64 decode
PROFILE_MAX_SIG_AGE=600          # reject a profile signature older/newer than this (seconds)

# ── per-coin websites (<ticker>.robinlabs.fun) ──────────────────────────────
# A coin's creator picks a template style + a subdomain slug (POST /api/coin/:token/site,
# creator-signed). The wildcard serving layer (pad/site.html on Vercel) resolves slug->coin.
# Slug moderation is built in (format + reserved words + a rot13'd slur/abuse wordlist). Extend it here:
# SITE_SLUG_BLOCKWORDS=            # extra blocked SUBSTRINGS (comma-separated, plain text). A slug containing any is refused.
# SITE_SLUG_BLOCKLIST=            # TAKEDOWN: exact slugs permanently refused (registration AND serving), e.g. a coin you pulled.
#                                # Serving a blocklisted slug returns HTTP 410 even if a row still points at it.

# ── docker-compose only ─────────────────────────────────────────────────────
# Your domain. Caddy gets an automatic HTTPS cert for it and serves BOTH the
# static pad and the API here. Leave blank / ":80" for local plain-HTTP testing.
# Then set API_BASE in pad/assets/config.js to "https://<this domain>".
SITE_DOMAIN=

# For a launch that could see 10k people at once, DON'T use the public RPC —
# point RPC_URL above at your Alchemy or QuickNode Robinhood Chain endpoint.
# The indexer is the only thing that talks to the RPC; users' wallets use their
# own. A private RPC also lets you raise CHUNK for much faster backfills.

# ── Uniswap Trading API proxy (top-token swaps) ─────────────────────────────────
# The whole /api/uni/* group is OFF unless UNISWAP_API_KEY is set. The key is a SECRET:
# it lives ONLY here (this .env is gitignored), is injected into the upstream call
# server-side, and is NEVER sent to the browser. Leave blank in .env.example.
UNISWAP_API_KEY=
# UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org   # override only if Uniswap moves it
# UNISWAP_CHAIN_ID=4663
# Our 1.25%/side integrator fee, taken IN-SWAP and paid to this recipient (the platform cold wallet).
UNISWAP_FEE_RECIPIENT=0xCDD5ff5d521D3694c2a2F31eDF7cd3C0E9a6fabf
UNISWAP_FEE_BIPS=125
# Curated, live-verified tradeable tokens (comma-separated, lowercased ok). Only these + native ETH route.
UNISWAP_TOKENS=0x020bfc650a365f8bb26819deaabf3e21291018b4,0x0339f5459fc690ac85f1782e15782a151b4a9e1b,0x45f82ac5d507e988f7406935da8eefe495a360e0,0x1541b925f0948c6d91be8b52320687ba62d30b64,0x499dc58539ba6869ee15b6c2a3c3c07f1ac4995f,0x2286397228be256529be1ae9ed8d7d16549e9c6a,0x9e94c8b5a0caeda5d0471c3a9f5ed4f3519d88c7,0x5266eeaff092d6136ab63d18b975a60a0cc0c8f7,0x8f100e99ddf699320724e37cb866770381d47382,0xc42cf61c16aac797b991cf9c1ac8ae70ba74a286,0x38bb87cf3e7344a82be7cd671c191f015b97eee6,0x86e5ac7ec60eeec0a8989f1f1d617ae18c15fa0c,0x41f41f7b849a25e027876c485544c8088f447a11,0x6696fe29288b586017e6f264c0091dba6c5ebeaf
# UNISWAP_RATE_PER_SEC=2       # per-IP cap on the proxy
# UNISWAP_GLOBAL_PER_SEC=6     # total upstream/sec (shared key budget) — raise once Uniswap grants a higher tier
# UNISWAP_CORS_ORIGINS=https://robinlab.io,https://www.robinlab.io,https://robinlabs.fun,https://www.robinlabs.fun

# ── LI.FI cross-chain bridge proxy ──────────────────────────────────────────────
# /api/lifi/* is OFF unless LIFI_API_KEY is set. SECRET: injected server-side into x-lifi-api-key so it
# never reaches the browser, and it moves us off LI.FI's keyless 75-req/2h/IP limit onto our per-key bucket.
LIFI_API_KEY=
# LIFI_INTEGRATOR=labs          # LI.FI Portal integrator id (fee wallet configured in the Portal)
# LIFI_FEE=0.01                 # our 1% integrator fee (LI.FI forwards it to the Portal wallet)
# LIFI_SRC_CHAINS=1,10,56,137,8453,42161   # allowed source chains (dest is always Robinhood Chain 4663)

# ── RobinLimit keeper (limit orders + DCA) ──────────────────────────────────────
# The keeper service fills signed limit/DCA orders. OFF (idle no-op) unless BOTH are set:
ROBIN_LIMIT=0xe1d37524E2992Aeb8943B229c42293264c8fA99C   # the deployed RobinLimit contract
KEEPER_KEY=                     # SECRET: a FUNDED hot wallet's private key — its own, NOT the deployer/cold key
# NOTE: RPC_URL (above) MUST be write-capable (your Alchemy endpoint), not the read-only Blockscout RPC —
# the keeper broadcasts execute() txs. Optional tuning:
# KEEPER_POLL_MS=30000          # poll interval
# KEEPER_GAS_CAP=3000000        # per-fill gas ceiling
# KEEPER_MIN_SLICE_WEI=2000000000000000   # skip dust slices below ~0.002 ETH-side
# KEEPER_PROFIT_MARGIN=2        # fee must exceed gas cost by this factor before filling

# ── Auto-graduate keeper ────────────────────────────────────────────────────────
# Bonds a curve coin the instant it's ready(), so nobody has to win the click-to-mine race by hand.
# Runs inside this same keeper process on KEEPER_KEY alone (no RobinLimit needed). Each graduation pays
# the platform 0.5 ETH while costing pennies of gas, so with rewards routed back it is self-funding.
# GRAD_KEEPER=1                 # set to 0 to disable the auto-graduate loop (default on when KEEPER_KEY is set)
# GRAD_POLL_MS=1000             # how often to check ready() (fast: one batched eth_call)
# GRAD_MIN_PROGRESS=0.9         # snapshot progress at which a coin enters the near-ceiling candidate set
# GRAD_SWEEP_MS=5000            # full-sweep cadence (every live curve, one batched read)
# GRAD_RECENT_S=120             # also check any coin that traded within this many seconds (fast-ramp catch)
# GRAD_GAS_MULT=1.2             # inclusion floor over base fee (Orbit is FCFS — this is NOT a priority auction)
# GRAD_GAS_CAP=12000000         # graduate() is heavy (deploys the Bond + mints the Sherwood LP)
# GRAD_MAX_ATTEMPTS=50          # broadcasts before a coin is parked, then retried
# GRAD_PARK_MS=300000           # park a chronic oscillator this long (5 min), then retry fresh
# GRAD_WAIT_MS=20000            # bound the receipt wait so nothing hangs
# GRAD_MIN_BALANCE=0.01         # skip + alert (never fire a doomed tx) if keeper ETH drops below this
# LP-fee sweep — collect each live curve's accrued Uniswap 1% fees to the platform/creator wallets before it bonds:
# GRAD_FEE_KEEPER=1             # set to 0 to disable the LP-fee sweep (default on when the keeper runs)
# GRAD_FEE_MS=600000            # sweep cadence (10 min); fees also roll into the Bond at graduation if left
# GRAD_FEE_MIN_WETH=0.01        # only collect a curve when its ETH-side fee clears this (skips dust; gas stays negligible)

# ── Photo-to-meme image proxy ───────────────────────────────────────────────────
# /api/meme/* is OFF unless MEME_API_KEY is set. OpenAI-compatible image-edit endpoint.
MEME_API_KEY=                   # SECRET: injected server-side, never reaches the browser
# MEME_API_BASE=https://api.openai.com/v1   # OpenAI-compatible base URL
# MEME_MODEL=gpt-image-1        # image model
# MEME_RATE_PER_SEC=1           # per-IP rate cap
# MEME_GLOBAL_PER_MIN=20        # global per-minute cap (bounds spend)

# ── Text-to-art image proxy (Venice) ────────────────────────────────────────────
# /api/art is OFF unless VENICE_API_KEY is set. Describe a coin, get its artwork back as a
# webp data URL. Sibling of the meme proxy above, which edits an uploaded photo instead.
VENICE_API_KEY=                 # SECRET: injected server-side, never reaches the browser.
#                               # Lives in the repo root .venice_key (gitignored) — NEVER in pad/,
#                               # which is a static site anyone can read with View Source.
# VENICE_API_BASE=https://api.venice.ai/api/v1
# THREE TIERS. The client names a TIER, never a model — which model serves it is a cost and a
# supplier relationship, not a product feature, and publishing it invites people to buy the same
# image direct. Prices are what the provider charges US per image, measured:
#   standard  venice-sd35         $0.01  -> 2 credits = $0.20
#   medium    nano-banana-2 1K    $0.10  -> 3 credits = $0.30
#   high      nano-banana-pro 1K  $0.18  -> 6 credits = $0.60
# Everything renders at 1K because everything is downscaled to VENICE_OUT_PX (512) anyway — a coin
# avatar is a 40px circle. Paying $0.23 for 2K and throwing four fifths away is $0.05 of nothing.
# On top of the model fee, each charge costs ~85.3k gas (~$0.015 here) paid by the operator.
# nano-banana-2-lite ($0.06) is deliberately unused: one solid-black result in three, billed in
# full — dearer AND less reliable than the $0.01 standard model.
# VENICE_MODEL_STANDARD=venice-sd35
# VENICE_MODEL_MEDIUM=nano-banana-2
# VENICE_MODEL_HIGH=nano-banana-pro
# VENICE_CREDITS_STANDARD=2     # price one credit at ~$0.10 and these become $0.20/$0.30/$0.60
# VENICE_CREDITS_MEDIUM=3
# VENICE_CREDITS_HIGH=6
# VENICE_RESOLUTION=1K          # raise VENICE_OUT_PX too, or the extra pixels are discarded
# VENICE_STEPS=25               # venice-sd35 caps at 30
# VENICE_OUT_PX=512             # 1024 PNG in (~2.1MB) -> 512 webp out (~19KB), measured
# VENICE_RATE_PER_SEC=1         # per-IP rate cap
# VENICE_GLOBAL_PER_MIN=10      # global per-minute cap — the hard spend bound (10c/min at $0.01)
# VENICE_MAX_PROMPT_CHARS=600   # user text is APPENDED to a fixed brief, never replaces it

# ── Fee keeper (walks fees from the router into stakers' hands) ─────────────────
# THE MONEY DOES NOT FLOW ON ITS OWN. A trade accrues it in the router and stops there; three calls
# have to happen afterwards and nothing in the system makes them until this keeper runs:
#   router.flushStaking(token) / router.flushRobin()  -> fees leave the router for the feeder
#   feeder.feedEth(pool, amount)                      -> the feeder pushes them into the pool
#   pool.releasePending()                             -> rewards parked while a pool was empty start
# OFF unless FEED_KEEPER_KEY + STAKING_FEEDER + TIER_STAKING_FACTORY are all set.
FEED_KEEPER_KEY=                # SECRET, low value: the destinations are fixed in the contracts (the
#                               # router's sinks are owner-set, the feeder can only pay registry
#                               # pools), so this key chooses TIMING, never where money goes.
STAKING_FEEDER=                 # the deployed StakingFeeder
# FEED_INTERVAL_MS=1800000      # sweep cadence (30 min)
# FEED_MIN_WEI=1000000000000000 # 0.001 ETH — below this a slice keeps accruing rather than paying gas
#
# ON-CHAIN WIRING THIS KEEPER CANNOT DO FOR YOU (each is silent when missing):
#   router.setStakingSink(feeder)   router.setRobinSink(feeder)
#   factory.setFeeder(feeder)       factory.setCreator(<pool maker>, true)
#   feeder.setOperator(<fee keeper>, true)

# ── Auto staking pools (every bonded coin gets one) ─────────────────────────────
# OFF unless BOTH are set. The keeper creates the pool AFTER graduation, in its own transaction —
# never inside graduate(), which is the one function that must never fail: a revert there strands
# the coin's entire raise with no rescue path. It is idempotent and it backfills, so coins that
# bonded before this shipped get pools too.
TIER_STAKING_FACTORY=           # the deployed RobinTierStakingFactory
POOL_MAKER_KEY=                 # SECRET, but deliberately low-value. It needs a CREATOR slot on the
#                               # factory: setCreator(<this address>, true). That slot can ADD a pool
#                               # to the registry and nothing else — pools are owned by the factory's
#                               # owner — so this key cannot configure rewards, change the boost, or
#                               # touch anyone's stake. Fund it with gas; treat it as disposable.
# POOL_BACKFILL_MS=900000       # how often to reconcile graduated coins against the registry

# ── Robin Labs AI (the pad's chat) ──────────────────────────────────────────────
# /api/chat is OFF unless GROQ_API_KEY is set. Two scopes: "pad" (how the launchpad works,
# answered from the shipped docs) and "coin" (one coin, answered ONLY from facts this server
# read on-chain). The system prompt is never accepted from the client — it carries the rules
# that stop a launchpad's chat box giving financial advice.
GROQ_API_KEY=                   # SECRET: lives in the repo root .groq_key (gitignored), never in pad/
# GROQ_MODEL=openai/gpt-oss-120b
# DOCS_ROOT=/srv/pad            # where docs.html + SECURITY.md are. The indexer does not always sit
#                               # next to the site — in the container only the web server mounts pad/.
#
# RATE LIMITS ARE PER MODEL, NOT PER ACCOUNT — so the pad ROTATES across a pool of them, and one
# model's limit stops being everyone's limit. Least-recently-used first; a 429 parks that model for
# exactly the provider's retry-after and the next one serves the request. Measured: 8 messages in
# 6 seconds, spread 3/3/2, zero rate limiting — a single model died at message 4.
#   pool = gpt-oss-120b + qwen3.8-27b + gpt-oss-20b
#   ~24K tokens/min combined (~11 msgs/min) and ~2.4M tokens/day (~1,100 msgs/day)
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
#
# NOT in the pool, and why:
#   qwen/qwen3.6-27b  returns its raw chain of thought inline — and on a prompt-injection attempt
#                     that monologue is the model reasoning about its own instructions out loud, to
#                     the person trying to extract them. Stripped defensively in code anyway.
#   groq/compound     70K/min and 250 req/day, but agentic: 2.5x the tokens per answer, 413s over
#                     ~1500 chars of context, and it can reach the WEB — asked how to launch it
#                     invented a "Create New Coin" button that does not exist.
# CHAT_CONTEXT_MAX_CHARS=3000   # 6000->2,968 tok/msg, 3000->2,306, 1500->1,848 (~1k-token floor)
# CHAT_CONTEXT_MAX_SECTIONS=3
# CHAT_MAX_TURNS=12             # history forwarded
# CHAT_MAX_REPLY_TOKENS=600
# CHAT_RATE_PER_SEC=1           # per-IP
# CHAT_GLOBAL_PER_MIN=60        # our own cap; the provider's is stricter on the free tier

# ── Art credits (the paywall in front of /api/art) ──────────────────────────────
# BOTH must be set or the art generator stays FREE and only the rate limits above bound it —
# fine for a closed beta, not fine in public. GET /api/art/enabled reports which mode it is in.
ART_CREDITS=                    # the deployed ArtCredits address
ART_OPERATOR_KEY=               # SECRET, but deliberately a LOW-VALUE one. ArtCredits requires the
#                               # customer's own signature on every spend, so this key can only relay
#                               # an authorisation somebody already gave. It cannot mint credits,
#                               # spend them unbidden, move ETH, or reprice anything. Fund it with a
#                               # little gas and nothing else, and rotate it freely.

# ── Launch announcer (posts new coins to Telegram) ──────────────────────────────
# The announcer service posts every new launch to a Telegram channel. OFF unless BOTH are set:
TG_BOT_TOKEN=                   # SECRET: a @BotFather bot token
TG_CHAT=                        # channel to post to: "@yourchannel" or a numeric chat id (add the bot as admin)
# ANNOUNCE_API_BASE=https://api.robinlab.io   # where the announcer READS launches from (/api/coins). Default
#                              # is this project's API; set it if this deployment's API base differs.
# ANNOUNCE_SITE_BASE=https://robinlab.io      # coin links point at the fresh site (default)
# ANNOUNCE_BANNER_URL=https://robinlab.io/assets/announce-banner.png  # promo graphic posted ON TOP of every
#                              # post (the coin's own image rides second in the same album). Point this at a host
#                              # that actually serves the pad's /assets, i.e. the SITE origin (ANNOUNCE_SITE_BASE,
#                              # e.g. robinlab.io on Vercel). An API-ONLY deploy (docker-compose.api.yml) serves NO
#                              # static files, so do NOT use that api host there. Use a PNG/JPG returning a direct
#                              # 200 (Telegram won't follow a redirect), NOT a webp. Blank = no banner.
# ANNOUNCE_GRADUATIONS=1        # 1 = also announce graduations, the payoff moment (default). 0 = launches only.
# ANNOUNCE_POLL_MS=30000        # how often to check for new launches / graduations
#
# TG_CHAT must be a @publicusername (no spaces) or a numeric id like -1001234567890 — NOT a display name.
# Smoke-test the whole pipeline without a real launch (posts ONE coin to the channel now):
#   docker compose run --rm announcer node src/announcer.js --test
# ANNOUNCE_BACKLOG=0            # 1 = also post coins that already exist on first run (default: seed silently)

# Blockscout Pro API key (optional). The free tier rate-limits per-IP hard enough to stall
# batch address reads and contract verification; a key raises the limit. Get one at
# dev.blockscout.com. SECRET — this file is an example, put the real value in .env only.
BLOCKSCOUT_API_KEY=

# Caddy, rebuilt with the GoDaddy DNS module.
#
# WHY THIS EXISTS. Coin sites live at <slug>.robinlabs.fun, which needs a WILDCARD certificate, and a
# wildcard can only be issued through a DNS-01 challenge — the CA makes you prove control by writing a
# TXT record, not by answering an HTTP request. Stock Caddy cannot do that: it has no way to touch DNS.
#
# The two alternatives were both worse. Moving the domain's nameservers to Vercel would hand DNS for
# robinlabs.fun to a third party while Microsoft 365 mail depends on seven records living there — one
# missed DKIM CNAME and mail silently starts failing authentication. Per-subdomain on-demand certificates
# avoid the wildcard entirely, but Let's Encrypt allows only ~50 certificates per registered domain per
# week, which is a launchpad-shaped wall.
#
# This asks Caddy to write the TXT record itself through GoDaddy's API. One wildcard certificate, renewed
# automatically, covering every coin that will ever launch. Nameservers stay where they are and the mail
# records are never touched.
FROM caddy:2-builder-alpine AS builder
RUN xcaddy build --with github.com/caddy-dns/godaddy

FROM caddy:2-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

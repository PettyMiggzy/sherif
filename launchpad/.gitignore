
# local secrets — never commit
.env
.env.local

# e2e runtime artifacts (staged pad copy, addresses, screenshots)
e2e/.run/

# transient verification/experiment helpers + logs (not part of the deliverable)
scripts/_*

# auto-verifier scan progress (regenerated at runtime; per-environment)
scripts/.auto-verify-state.json

# Scratch test files audit subagents write while reproducing a finding. They are transient — the agent
# deletes them again — and a half-written one breaks `npx hardhat test` for everyone. Anything worth
# keeping gets promoted to a real name (see test/poolsquat-*.test.js, which began this way).
test/zz*.test.js

# Scratch probe scripts written by audit/verification agents. Throwaway by nature — they are
# written, run against a live RPC, and abandoned. Never part of the repo.
_audit/

# Scratch probe scripts written by verification agents — written, run against a live RPC, abandoned.
_audit/

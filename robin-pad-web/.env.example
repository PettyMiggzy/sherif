# Copy to .env.local (or set these in Vercel) only to override the defaults.
# Every value below is already the built-in default in lib/config.ts, so the
# site builds and runs against Robinhood Chain mainnet with no env at all.

# Robinhood Chain's own RPC: CORS-open and write-capable (wallets are handed
# it when they add the network). It ships in the site bundle, so it's public.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Robin Labs Pad on Robinhood Chain (usdg-pad/docs/ROBINHOOD-DEPLOY.md).
NEXT_PUBLIC_PORTAL=0x7e2f5dEe1A846fF21eE946d2e450F64133d0fD6F
NEXT_PUBLIC_HOOK=0x04abDE4e77036178E0DF13d435B7b7f87265e8cc
NEXT_PUBLIC_TREASURY=0x2F59476D23dE13e1Cd171d69Efe1227dE8349D3f
NEXT_PUBLIC_PORTAL_GENESIS_BLOCK=73073570
NEXT_PUBLIC_PAD_ADMIN=0x5899a0576A94327a6316E01190f951edf7645914

# Uniswap v4 on Robinhood Chain.
NEXT_PUBLIC_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
NEXT_PUBLIC_ROUTER=0x8876789976decbfcbbbe364623c63652db8c0904
NEXT_PUBLIC_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
# Every pool's quote asset (6 decimals). Gas is ETH.
NEXT_PUBLIC_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_QUOTE_IS_NATIVE=false
NEXT_PUBLIC_QUOTE_DECIMALS=6

NEXT_PUBLIC_BRAND=Robin Labs Pad
NEXT_PUBLIC_TAGLINE=Pick your price. Launch in one transaction.
NEXT_PUBLIC_HOME_URL=https://robinlab.io
# Market cap the progress bars on launch cards fill toward.
NEXT_PUBLIC_MILESTONE_USD=30000
# This site's public URL, so social previews get absolute image links.
NEXT_PUBLIC_SITE_URL=https://www.robinlab.io

# Backup RPC for when the public one fails or challenges. Server-only; defaults
# to Robin Labs' read proxy (https://api.robinlab.io/rpc). Browsers reach it
# through this site's /api/rpc relay; NEXT_PUBLIC_RPC_FALLBACK=0 turns that off.
RPC_FALLBACK_URL=
NEXT_PUBLIC_RPC_FALLBACK=

# Optional: a pad-indexer for 24h volume, trades, holders and candles.
NEXT_PUBLIC_INDEXER_URL=
# WalletConnect (phone wallets). Defaults to robinlab.io's project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=89d7a1882c0fa9a5bbe0a58accafc100
# Server-only: a private Vercel Blob store for token pictures/descriptions and
# the launch-list snapshot. Without it the site still works; details can't be saved.
BLOB_READ_WRITE_TOKEN=

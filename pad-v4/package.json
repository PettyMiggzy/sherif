{
  "name": "robin-pad-v4",
  "version": "0.1.0",
  "private": true,
  "description": "Robin V4 — 'pad of pads' multi-pad launchpad on Uniswap V4 (Robinhood Chain 4663). Immutable factory, 3-way afterSwap fee hook, dual staking, USDG-yield floor vault, tokenized-stock pad.",

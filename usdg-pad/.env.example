# Used by script/DeployRobinhood.s.sol. Copy to .env, fill in, never commit
# .env itself (gitignored). Prefer --account <keystore> or --ledger over a
# raw key: forge script ... --broadcast --legacy --account <name> --sender <address>

# The EOA that deploys everything. It becomes the hook's bootstrapper and the
# owner of the treasury, the factory and the house pad. Needs ETH for gas
# (about 0.001 ETH at 2026-09-26 prices; hold ~0.005). It needs no USDG.
DEPLOYER_PRIVATE_KEY=

# Robinhood Chain mainnet (chain 4663). The chain's own endpoint works; a
# paid RPC is fine too. Never commit a URL that embeds an API key.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional:
# HOUSE_PAD_NAME="Robin Labs Pad"   # the house pad's on-chain name
# PAD_SETUP_FEE=100000000      # white-label pad price in raw USDG (6 decimals): 100000000 = $100

# Tests: set to run test/ForkRobinhood.t.sol against real chain state.
# ROBINHOOD_FORK_URL=https://rpc.mainnet.chain.robinhood.com
